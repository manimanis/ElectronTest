{
  "name": "folder-cleaner",
  "version": "1.0.0",
  "description": "Desktop application to clean folder contents",
  "author": "Mohamed Anis MANI",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-icon.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "predist": "node scripts/generate-icon.mjs",
    "dist": "vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "vitest": {
    "globals": true,
    "environment": "happy-dom",
    "setupFiles": [
      "./tests/setup.js"
    ],
    "include": [
      "tests/**/*.test.js"
    ],
    "deps": {
      "inline": [
        "vue-virtual-scroller"
      ]
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.1.1"
  },
  "allowScripts": {
    "electron@41.7.1": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.folder-analyzer.app",
    "productName": "Folder Analyzer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
